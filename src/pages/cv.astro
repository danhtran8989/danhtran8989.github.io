---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { cvConfig } from '../data/config';

const { title, lede, panel, main } = cvConfig;
---
<Layout title={`CV — ${site.name}`} description={lede}>
	<PageHero path="/cv" title={title} lede={lede} />

	<section class="section">
		<div class="container cv-grid">
			<aside class="cv-panel">
				<div>
					<p class="eyebrow eyebrow--panel">{panel.eyebrow}</p>
					<h2 class="cv-name">{site.name}</h2>
					<p class="cv-role">{panel.role}</p>

					<div class="cv-block">
						<p class="eyebrow eyebrow--panel">Contact</p>
						<ul class="cv-list">
							{
								panel.contact.map((item) =>
									item.href ? (
										<li>
											<a
												href={item.href}
												target={item.href.startsWith('mailto:') ? undefined : '_blank'}
												rel={item.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
											>
												{item.text}
											</a>
										</li>
									) : (
										<li>{item.text}</li>
									),
								)
							}
						</ul>
					</div>

					<div class="cv-block">
						<p class="eyebrow eyebrow--panel">{panel.interests.eyebrow}</p>
						<ul class="cv-list">
							{panel.interests.items.map((item) => <li>{item}</li>)}
						</ul>
					</div>

					<div class="cv-block">
						<p class="eyebrow eyebrow--panel">{panel.languages.eyebrow}</p>
						<ul class="cv-list">
							{panel.languages.items.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</div>

				<button class="btn btn--block cv-download" type="button" data-print>
					{panel.downloadLabel} <Icon name="down" />
				</button>
			</aside>

			<div class="cv-main">
				<p class="eyebrow">{main.eyebrow}</p>

				{
					main.sections.map((section) => (
						<section class="cv-section">
							<div>
								<h2 class="cv-heading">{section.heading}</h2>
								{section.dates && <p class="cv-dates">{section.dates}</p>}
							</div>
							<div class="cv-content">
								{(section.text ?? []).map((paragraph) => <p>{paragraph}</p>)}
								{(section.entries ?? []).map((entry) => (
									<article class="cv-entry">
										<div class="cv-entry__head">
											<h3>
												{entry.href ? (
													<a href={entry.href} target="_blank" rel="noopener noreferrer">
														{entry.title}
													</a>
												) : (
													entry.title
												)}
											</h3>
											{entry.dates && <span class="cv-entry__dates">{entry.dates}</span>}
										</div>
										{entry.meta && <p class="cv-subtle">{entry.meta}</p>}
										{entry.bullets && entry.bullets.length > 0 && (
											<ul class="cv-bullets">
												{entry.bullets.map((bullet) => <li>{bullet}</li>)}
											</ul>
										)}
									</article>
								))}
								{section.next && (
									<p class="cv-next">
										<span>{section.next.label}</span>
										<a class="link-arrow link-arrow--accent" href={section.next.href}>
											{section.next.linkLabel} <Icon name="right" />
										</a>
									</p>
								)}
							</div>
						</section>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	.cv-grid {
		display: grid;
		grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
		gap: clamp(36px, 5vw, 64px);
		align-items: start;
	}

	.cv-panel {
		position: sticky;
		top: calc(var(--header-height) + 24px);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 48px;
		min-height: 780px;
		padding: clamp(28px, 3vw, 38px);
		border-radius: var(--radius-md);
		background:
			radial-gradient(70% 50% at 88% 4%, rgba(167, 139, 250, 0.28), transparent 62%),
			linear-gradient(165deg, var(--panel-2), var(--panel));
		color: var(--on-panel);
		box-shadow: var(--shadow-md);
	}

	.cv-name {
		margin-top: 42px;
		font-size: clamp(32px, 3.1vw, 40px);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.035em;
	}

	.cv-role {
		margin-top: 6px;
		font-size: 16px;
		color: var(--panel-muted);
	}

	.cv-block {
		margin-top: 40px;
	}

	.cv-list {
		margin-top: 14px;
		font-size: 15px;
		line-height: 1.8;
		color: var(--on-panel);
	}

	.cv-list a {
		transition: color 160ms ease;
	}

	.cv-list a:hover {
		color: var(--panel-accent);
	}

	.cv-download {
		background: var(--panel-accent);
		color: var(--panel);
	}

	.cv-download:hover {
		background: var(--on-panel);
		color: var(--panel);
	}

	:root[data-theme='dark'] .cv-download {
		color: var(--panel);
	}

	.cv-main {
		padding-top: 6px;
	}

	.cv-section {
		display: grid;
		grid-template-columns: minmax(180px, 240px) minmax(0, 1fr);
		gap: clamp(24px, 4vw, 56px);
		padding-block: clamp(28px, 3.4vw, 40px);
		border-top: 1px solid var(--line);
	}

	.cv-main > .eyebrow + .cv-section {
		margin-top: 32px;
	}

	.cv-heading {
		font-size: clamp(24px, 2.5vw, 30px);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.03em;
	}

	.cv-dates {
		margin-top: 12px;
		font-size: 13.5px;
		color: var(--muted);
	}

	.cv-content {
		font-size: 16.5px;
		line-height: 1.65;
		color: var(--muted);
	}

	.cv-content h3 {
		font-size: clamp(20px, 1.9vw, 23px);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.cv-content p {
		margin-top: 10px;
	}

	.cv-content .cv-subtle {
		font-size: 15px;
		color: var(--muted);
		opacity: 0.85;
	}

	.cv-entry + .cv-entry {
		margin-top: 30px;
		padding-top: 30px;
		border-top: 1px dashed var(--line);
	}

	.cv-entry__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	.cv-entry__head h3 a {
		transition: color 160ms ease;
	}

	.cv-entry__head h3 a:hover {
		color: var(--accent);
	}

	.cv-entry__dates {
		font-size: 12.5px;
		font-weight: 500;
		letter-spacing: 0.06em;
		color: var(--muted);
		white-space: nowrap;
	}

	.cv-bullets {
		display: grid;
		gap: 6px;
		margin-top: 12px;
		padding-left: 1.1em;
		list-style: disc;
		font-size: 15.5px;
		line-height: 1.55;
		color: var(--muted);
	}

	.cv-next {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
		margin-top: 28px !important;
		font-size: 15px;
		color: var(--ink);
	}

	.cv-next span {
		font-weight: 600;
	}

	@media (max-width: 980px) {
		.cv-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.cv-panel {
			position: static;
			min-height: 0;
			gap: 36px;
		}
	}

	@media (max-width: 700px) {
		.cv-section {
			grid-template-columns: minmax(0, 1fr);
			gap: 14px;
		}
	}
</style>