---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { certificateGroups, site } from '../data/site';
import { certificatesConfig } from '../data/config';

const { title, lede, sectionEyebrow, sectionNote, learningBand } = certificatesConfig;
const total = certificateGroups.reduce((sum, group) => sum + group.items.length, 0);
---

<Layout
	title={`Certificates — ${site.name}`}
	description="Course completions, programs, and learning milestones, grouped by provider."
>
	<PageHero path="/certificates" title={title} lede={lede} />

	<section class="section">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">{sectionEyebrow}</p>
				<p class="section-note">{sectionNote}</p>
			</div>

			<ul class="provider-jump">
				{
					certificateGroups.map((group) => (
						<li>
							<a href={`#${group.provider.toLowerCase().replace(/\s+/g, '-')}`}>
								{group.provider}
								<span>{String(group.items.length).padStart(2, '0')}</span>
							</a>
						</li>
					))
				}
			</ul>

			<div class="provider-list">
				{
					certificateGroups.map((group) => (
						<section class="provider" id={group.provider.toLowerCase().replace(/\s+/g, '-')}>
							<header class="provider__head">
								<h2 class="provider__name">{group.provider}</h2>
								<p class="provider__note">{group.note}</p>
							</header>

							<ul class="cert-grid">
								{group.items.map((certificate) => (
									<li class="cert-card">
										<p class="eyebrow cert-date">{certificate.date}</p>
										<h3 class="cert-title">
											{certificate.href ? (
												<a href={certificate.href} target="_blank" rel="noopener noreferrer">
													{certificate.title}
												</a>
											) : (
												certificate.title
											)}
										</h3>
										<p class="cert-desc">{certificate.description}</p>
										{certificate.href ? (
											<a
												class="link-arrow cert-link"
												href={certificate.href}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`Verify certificate: ${certificate.title}`}
											>
												View certificate <Icon name="up-right" />
											</a>
										) : (
											<span class="cert-link cert-link--muted">Issued badge · no public link</span>
										)}
									</li>
								))}
							</ul>
						</section>
					))
				}
			</div>

			<div class="learning-band">
				<h2 class="band-title">{learningBand.title}</h2>
				<div class="band-copy">
					<p>
						{total} credentials in total. {learningBand.question}
					</p>
					<a class="link-arrow" href="/certifications">
						{learningBand.linkLabel} <Icon name="right" />
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.provider-jump {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: clamp(30px, 3.4vw, 44px);
	}

	.provider-jump a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 12px;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
		transition:
			border-color 160ms ease,
			color 160ms ease,
			background-color 160ms ease;
	}

	.provider-jump a span {
		font-size: 10px;
		color: var(--accent);
	}

	.provider-jump a:hover {
		border-color: var(--line-strong);
		background: var(--surface);
		color: var(--ink);
	}

	.provider + .provider {
		margin-top: clamp(34px, 4vw, 56px);
		padding-top: clamp(30px, 3.6vw, 46px);
		border-top: 1px solid var(--line);
	}

	.provider__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
		margin-bottom: clamp(18px, 2.2vw, 26px);
	}

	.provider__name {
		font-size: clamp(22px, 2.4vw, 30px);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.03em;
	}

	.provider__note {
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.cert-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(258px, 1fr));
		gap: clamp(14px, 1.6vw, 20px);
	}

	.cert-card {
		display: flex;
		flex-direction: column;
		padding: clamp(18px, 1.9vw, 23px);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--surface);
		transition:
			border-color 200ms ease,
			box-shadow 200ms ease,
			transform 200ms ease;
	}

	.cert-card:hover {
		transform: translateY(-2px);
		border-color: var(--line-strong);
		box-shadow: var(--shadow-md);
	}

	.cert-date {
		font-size: 10px;
	}

	.cert-title {
		margin-top: 10px;
		font-size: 17px;
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.02em;
	}

	.cert-title a {
		transition: color 160ms ease;
	}

	.cert-title a:hover {
		color: var(--accent);
	}

	.cert-desc {
		margin-top: 8px;
		font-size: 13.5px;
		line-height: 1.55;
		color: var(--muted);
	}

	.cert-link {
		margin-top: auto;
		padding-top: 16px;
		font-size: 12px;
		letter-spacing: 0.04em;
	}

	.cert-link--muted {
		color: var(--muted);
		opacity: 0.75;
	}

	.learning-band {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(24px, 3vw, 40px);
		margin-top: clamp(40px, 4.4vw, 60px);
		padding: clamp(30px, 4vw, 54px);
		overflow: hidden;
		border-radius: var(--radius-md);
		background:
			radial-gradient(70% 70% at 88% 0%, rgba(167, 139, 250, 0.34), transparent 64%),
			linear-gradient(155deg, var(--panel-2), var(--panel));
		color: var(--on-panel);
	}

	.learning-band::before {
		content: '';
		position: absolute;
		right: -12%;
		bottom: -46%;
		width: 46%;
		aspect-ratio: 1;
		border: 1px solid var(--panel-line);
		border-radius: 50%;
		pointer-events: none;
	}

	.band-title {
		position: relative;
		z-index: 1;
		max-width: 16ch;
		font-size: clamp(26px, 3vw, 40px);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	.band-copy {
		position: relative;
		z-index: 1;
		font-size: 15px;
		line-height: 1.7;
		color: var(--panel-muted);
	}

	.band-copy .link-arrow {
		margin-top: 6px;
		font-size: 14px;
		color: var(--panel-accent);
	}

	.band-copy .link-arrow:hover {
		color: var(--on-panel);
	}

	@media (max-width: 760px) {
		.learning-band {
			grid-template-columns: minmax(0, 1fr);
			gap: 12px;
		}
	}
</style>
