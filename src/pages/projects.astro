---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projectLabels, projects, site } from '../data/site';
import { projectsConfig } from '../data/config';

const { title, lede, sectionEyebrow, sectionNote, cta } = projectsConfig;
---

<Layout title={`Projects — ${site.name}`} description={lede}>
	<PageHero path="/projects" title={title} lede={lede} />

	<section class="section projects-section">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">{sectionEyebrow}</p>
				<p class="section-note">{sectionNote}</p>
			</div>

			<ul class="project-grid">
				{
					projects.map((project, index) => (
						<ProjectCard
							project={project}
							index={index}
							labels={projectLabels}
							showDescription
						/>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section section--tight cta-section">
		<div class="container">
			<div class="cta-row">
				<h2 class="cta-title">{cta.title}</h2>
				<a class="btn btn--outline" href={`mailto:${site.email}`}>
					{cta.linkLabel}
					<Icon name="up-right" />
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(30px, 4vw, 58px) clamp(24px, 3.4vw, 48px);
	}

	.projects-section {
		padding-bottom: 0;
	}

	.cta-section {
		padding-top: 0;
	}

	.cta-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		margin-top: clamp(36px, 4vw, 54px);
		padding-block: clamp(28px, 3vw, 40px);
		border-block: 1px solid var(--line);
	}

	.cta-title {
		font-size: clamp(25px, 2.8vw, 38px);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.035em;
	}

	.cta-row .btn {
		flex: none;
	}

	@media (max-width: 820px) {
		.project-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 640px) {
		.cta-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 18px;
		}
	}
</style>
