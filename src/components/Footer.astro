---
import { site } from '../data/site';
import Icon from './Icon.astro';

const { footer } = site;
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-cta">
			<p class="eyebrow eyebrow--accent">{footer.eyebrow}</p>
			<a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>
		</div>

		<div class="footer-grid">
			<div>
				<a class="footer-brand" href="/">{site.name}<span>.</span></a>
				<p class="footer-note">{footer.note}</p>
			</div>

			<div class="footer-column">
				<p class="footer-label">{footer.linksLabel}</p>
				<div class="footer-socials">
					{
						site.socials.map((social) => (
							<a
								href={social.href}
								rel="noopener noreferrer"
								target={social.href.startsWith('mailto:') ? undefined : '_blank'}
							>
								{social.label}
								<Icon name="up-right" />
							</a>
						))
					}
				</div>
			</div>

			<div class="footer-column">
				<p class="footer-label">{footer.contactLabel}</p>
				<div class="footer-contact">
					<a href={`mailto:${site.email}`}>{site.email}</a>
					<a href={`https://${site.domain}`} target="_blank" rel="noopener noreferrer">
						{site.domain}
					</a>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
		</div>
	</div>
</footer>
