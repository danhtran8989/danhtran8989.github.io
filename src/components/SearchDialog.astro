---
import Icon from './Icon.astro';
import { searchGroups, searchItems } from '../data/search';
---

<div class="search-dialog" data-search-dialog hidden>
	<div class="search-dialog__backdrop" data-search-close></div>

	<div class="search-dialog__panel" data-search-panel role="dialog" aria-modal="true" aria-labelledby="search-dialog-title">
		<h2 class="sr-only" id="search-dialog-title">Search this site</h2>

		<div class="search-dialog__bar">
			<Icon name="search" class="search-dialog__icon" />
			<input
				class="search-dialog__input"
				type="search"
				placeholder="Type to start searching"
				autocomplete="off"
				spellcheck="false"
				role="combobox"
				aria-expanded="true"
				aria-controls="search-results"
				aria-autocomplete="list"
				aria-label="Search this site"
				data-search-input
			/>
			<button class="search-dialog__close" type="button" data-search-close aria-label="Close search">
				<kbd>esc</kbd>
			</button>
		</div>

		<div class="search-dialog__body">
			<div class="search-results" id="search-results" role="listbox" aria-label="Search results" data-search-results></div>
			<p class="search-empty" data-search-empty hidden>
				No results for “<span data-search-query></span>”. Try a page name, a topic, or a skill.
			</p>
		</div>

		<div class="search-dialog__foot">
			<span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
			<span><kbd>↵</kbd> to select</span>
			<span><kbd>esc</kbd> to close</span>
		</div>
	</div>
</div>

<script define:vars={{ searchItems, searchGroups }}>
	const dialog = document.querySelector('[data-search-dialog]');
	const input = document.querySelector('[data-search-input]');
	const list = document.querySelector('[data-search-results]');
	const empty = document.querySelector('[data-search-empty]');
	const emptyQuery = document.querySelector('[data-search-query]');
	const triggers = document.querySelectorAll('[data-search-open]');
	const closeButton = dialog ? dialog.querySelector('.search-dialog__close') : null;

	if (dialog && input && list) {
		const normalize = (value) =>
			value
				.toLowerCase()
				.normalize('NFD')
				.replace(/[\u0300-\u036f]/g, '');

		const escapeHtml = (value) =>
			value.replace(
				/[&<>"']/g,
				(character) =>
					({
						'&': '&amp;',
						'<': '&lt;',
						'>': '&gt;',
						'"': '&quot;',
						"'": '&#39;',
					})[character],
			);

		let active = -1;
		let isOpen = false;
		let lastFocused = null;

		const regions = document.querySelectorAll('body > header, body > main, body > footer');

		const setActive = (index, scroll = true) => {
			const options = Array.from(list.querySelectorAll('[role="option"]'));
			if (!options.length) {
				active = -1;
				input.removeAttribute('aria-activedescendant');
				return;
			}

			active = (index + options.length) % options.length;

			options.forEach((option, optionIndex) => {
				const selected = optionIndex === active;
				option.classList.toggle('is-active', selected);
				option.setAttribute('aria-selected', String(selected));

				if (selected) {
					input.setAttribute('aria-activedescendant', option.id);
					if (scroll) option.scrollIntoView({ block: 'nearest' });
				}
			});
		};

		const render = (query) => {
			const terms = normalize(query).trim().split(/\s+/).filter(Boolean);
			const scored = [];

			searchItems.forEach((item, order) => {
				const title = normalize(item.title);
				const haystack = normalize(
					[item.title, item.description ?? '', item.meta, ...(item.keywords ?? [])].join(' '),
				);
				let score = 0;

				for (const term of terms) {
					if (!haystack.includes(term)) {
						score = -1;
						break;
					}

					if (title.startsWith(term)) score += 10;
					else if (title.includes(term)) score += 6;
					else if (normalize(item.meta).includes(term)) score += 3;
					else if ((item.keywords ?? []).some((keyword) => normalize(keyword).includes(term))) score += 2;
					else score += 1;
				}

				if (score >= 0) scored.push({ item, score, order });
			});

			scored.sort((a, b) => b.score - a.score || a.order - b.order);

			const visible = scored.slice(0, 40);
			list.textContent = '';

			let optionIndex = 0;

			searchGroups.forEach((group) => {
				const items = visible.filter((entry) => entry.item.group === group);
				if (!items.length) return;

				const section = document.createElement('div');
				section.className = 'search-group';
				section.setAttribute('role', 'group');
				section.setAttribute('aria-label', group);

				const label = document.createElement('p');
				label.className = 'search-group__label';
				label.textContent = group;
				section.appendChild(label);

				const groupList = document.createElement('ul');
				groupList.className = 'search-group__list';

				items.forEach(({ item }) => {
					const option = document.createElement('li');
					option.className = 'search-result';
					option.id = `search-option-${optionIndex}`;
					option.setAttribute('role', 'option');
					option.setAttribute('aria-selected', 'false');
					option.dataset.index = String(optionIndex);

					const link = document.createElement('a');
					link.className = 'search-result__link';
					link.href = item.href;
					link.tabIndex = -1;

					if (item.external) {
						link.target = '_blank';
						link.rel = 'noopener noreferrer';
					}

					link.innerHTML = `
						<span class="search-result__text">
							<span class="search-result__title">${escapeHtml(item.title)}</span>
							${item.description ? `<span class="search-result__desc">${escapeHtml(item.description)}</span>` : ''}
						</span>
						<span class="search-result__meta">${escapeHtml(item.meta)}</span>
					`;

					option.appendChild(link);
					groupList.appendChild(option);
					optionIndex += 1;
				});

				section.appendChild(groupList);
				list.appendChild(section);
			});

			const hasResults = optionIndex > 0;
			list.hidden = !hasResults;
			empty.hidden = hasResults;
			if (emptyQuery) emptyQuery.textContent = query.trim();

			setActive(hasResults ? 0 : -1, false);
		};

		const setOpen = (next) => {
			if (next === isOpen) return;
			isOpen = next;

			if (next) {
				lastFocused = document.activeElement;
				dialog.hidden = false;
				document.documentElement.classList.add('search-open');
				regions.forEach((region) => region.setAttribute('inert', ''));

				input.value = '';
				render('');
				setActive(0, false);

				void dialog.offsetWidth;
				dialog.classList.add('is-open');
				input.focus();
			} else {
				dialog.classList.remove('is-open');
				dialog.hidden = true;
				document.documentElement.classList.remove('search-open');
				regions.forEach((region) => region.removeAttribute('inert'));

				if (lastFocused instanceof HTMLElement) lastFocused.focus();
			}
		};

		triggers.forEach((trigger) => {
			trigger.addEventListener('click', () => setOpen(true));
		});

		dialog.querySelectorAll('[data-search-close]').forEach((closer) => {
			closer.addEventListener('click', () => setOpen(false));
		});

		input.addEventListener('input', () => {
			render(input.value);
		});

		list.addEventListener('mousemove', (event) => {
			const option = event.target.closest('[role="option"]');
			if (option && option.dataset.index !== undefined) {
				setActive(Number(option.dataset.index), false);
			}
		});

		list.addEventListener('click', (event) => {
			if (event.target.closest('a')) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			const key = event.key;

			if ((event.metaKey || event.ctrlKey) && key.toLowerCase() === 'k') {
				event.preventDefault();
				setOpen(!isOpen);
				return;
			}

			if (!isOpen) {
				if (key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey) {
					const target = event.target;
					const isTyping =
						target instanceof HTMLElement &&
						(target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName));

					if (!isTyping) {
						event.preventDefault();
						setOpen(true);
					}
				}
				return;
			}

			if (key === 'Escape') {
				event.preventDefault();
				setOpen(false);
			} else if (key === 'ArrowDown') {
				event.preventDefault();
				setActive(active + 1);
			} else if (key === 'ArrowUp') {
				event.preventDefault();
				setActive(active - 1);
			} else if (key === 'Home') {
				event.preventDefault();
				setActive(0);
			} else if (key === 'End') {
				event.preventDefault();
				setActive(-1);
			} else if (key === 'Enter' && active >= 0) {
				const option = list.querySelectorAll('[role="option"]')[active];
				const link = option ? option.querySelector('a') : null;
				if (link) {
					event.preventDefault();
					link.click();
				}
			} else if (key === 'Tab') {
				event.preventDefault();
				const focusable = [input, closeButton].filter(Boolean);
				const currentIndex = focusable.indexOf(document.activeElement);
				const direction = event.shiftKey ? -1 : 1;
				const nextIndex = (currentIndex + direction + focusable.length) % focusable.length;
				focusable[nextIndex].focus();
			}
		});

		const platform = navigator.userAgentData?.platform ?? navigator.platform ?? '';
		const keyHint = document.querySelector('[data-search-key]');
		if (keyHint && /Mac|iPhone|iPad/.test(platform)) keyHint.textContent = '⌘ K';
	}
</script>
