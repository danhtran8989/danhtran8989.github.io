---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { aboutConfig } from '../data/config';

interface Props {
	path?: string;
}

const { path = '/about' } = Astro.props;

const { title, lede, intro, currently, principles } = aboutConfig;
---

<Layout title={`About — ${site.name}`} description={lede}>
	<PageHero path={path} title={title} lede={lede} />

	<section class="section">
		<div class="container about-grid">
			<div class="about-copy">
				<p class="eyebrow">{intro.eyebrow}</p>
				<h2 class="about-display">{intro.display}</h2>
				<div class="about-body">
					{intro.body.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</div>

			<aside class="currently" aria-labelledby="currently-title">
				<div>
					<p class="eyebrow currently__eyebrow">{currently.eyebrow}</p>
					<p class="currently__title" id="currently-title">
						{currently.title}
					</p>
				</div>
				<div>
					<div class="currently__rule"></div>
					<a class="currently__link" href="#principles">
						{currently.link}
						<Icon name="up-right" />
					</a>
				</div>
			</aside>
		</div>
	</section>

	<section class="section section--tight" id="principles">
		<div class="container">
			<ul class="principles">
				{
					principles.map((item) => (
						<li class="principle">
							<span class="principle__index">{item.index}</span>
							<div>
								<h2 class="principle__title">{item.title}</h2>
								<p class="principle__copy">{item.description}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>

<style>
	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.8fr);
		gap: clamp(40px, 6vw, 96px);
		align-items: start;
	}

	.about-display {
		margin-top: 18px;
		max-width: 15ch;
		font-size: clamp(34px, 4.4vw, 58px);
		font-weight: 600;
		line-height: 1.04;
		letter-spacing: -0.04em;
	}

	.about-body {
		margin-top: clamp(24px, 3vw, 36px);
		max-width: 56ch;
		font-size: clamp(16px, 1.3vw, 18px);
		line-height: 1.75;
		color: var(--muted);
	}

	.about-body p + p {
		margin-top: 1.2em;
	}

	.currently {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 48px;
		min-height: 340px;
		padding: clamp(26px, 2.6vw, 36px);
		overflow: hidden;
		border-radius: var(--radius-md);
		background:
			radial-gradient(75% 60% at 82% 6%, rgba(167, 139, 250, 0.32), transparent 66%),
			linear-gradient(160deg, var(--panel-2), var(--panel));
		color: var(--on-panel);
		box-shadow: var(--shadow-md);
	}

	.currently::before {
		content: '';
		position: absolute;
		top: -30%;
		right: -34%;
		width: 92%;
		aspect-ratio: 1;
		border: 1px solid var(--panel-line);
		border-radius: 50%;
		pointer-events: none;
	}

	.currently > * {
		position: relative;
		z-index: 1;
	}

	.currently__eyebrow {
		color: var(--panel-accent);
	}

	.currently__title {
		margin-top: 40px;
		font-family: var(--font-display);
		font-size: clamp(26px, 2.4vw, 32px);
		font-weight: 600;
		line-height: 1.14;
		letter-spacing: -0.03em;
	}

	.currently__rule {
		height: 1px;
		margin-bottom: 20px;
		background: var(--panel-line);
	}

	.currently__link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 14px;
		font-weight: 500;
		color: var(--panel-muted);
		transition:
			color 160ms ease,
			gap 160ms ease;
	}

	.currently__link:hover {
		gap: 12px;
		color: var(--on-panel);
	}

	.principles {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(24px, 3.4vw, 52px);
		padding-top: clamp(28px, 3vw, 38px);
		border-top: 1px solid var(--line);
	}

	.principle {
		display: grid;
		grid-template-columns: 32px minmax(0, 1fr);
		gap: 18px;
	}

	.principle__index {
		padding-top: 4px;
		font-family: var(--font-display);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.12em;
		color: var(--accent);
	}

	.principle__title {
		font-size: clamp(20px, 1.8vw, 24px);
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.025em;
	}

	.principle__copy {
		margin-top: 8px;
		font-size: 14.5px;
		line-height: 1.6;
		color: var(--muted);
	}

	@media (max-width: 900px) {
		.about-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.currently {
			min-height: 0;
			gap: 36px;
		}

		.principles {
			grid-template-columns: minmax(0, 1fr);
			gap: 26px;
		}
	}
</style>
