---
import Icon from './Icon.astro';

interface Project {
	eyebrow: string;
	mark: string;
	status: string;
	title: string;
	description: string;
	meta: string;
	href: string;
}

interface Props {
	project: Project;
	index: number;
	labels: { scope: string; stack: string };
	showDescription?: boolean;
}

const { project, index, labels, showDescription = false } = Astro.props;

const variant = (index % 3) + 1;
const number = String(index + 1).padStart(2, '0');
const external = project.href.startsWith('http');

const linkProps = {
	href: project.href,
	target: external ? '_blank' : undefined,
	rel: external ? 'noopener noreferrer' : undefined,
};
---

<li class="project-card">
	<a
		class:list={['project-card__media', `project-card__media--${variant}`]}
		{...linkProps}
		aria-hidden="true"
		tabindex="-1"
	>
		<span class="project-card__art"></span>
		<span class="project-card__index">{number}</span>
		<span class="project-card__status">{project.status}</span>
	</a>

	<div class="project-card__head">
		<h3 class="project-card__title">
			<a {...linkProps}>{project.title}</a>
		</h3>
		<span class="project-card__dash" aria-hidden="true"></span>
		<a class="project-card__open" {...linkProps} aria-label={`Open ${project.title}`}>
			<Icon name="up-right" />
		</a>
	</div>

	{showDescription && <p class="project-card__copy">{project.description}</p>}

	<dl class="project-card__meta">
		<div>
			<dt>{labels.scope}</dt>
			<dd>{project.eyebrow}</dd>
		</div>
		<div>
			<dt>{labels.stack}</dt>
			<dd>{project.meta}</dd>
		</div>
	</dl>
</li>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.project-card__media {
		position: relative;
		display: block;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: #0b0712;
		isolation: isolate;
	}

	.project-card__media--1 {
		--art-a: rgba(167, 139, 250, 0.95);
		--art-b: rgba(109, 40, 217, 0.58);
	}

	.project-card__media--2 {
		--art-a: rgba(217, 70, 239, 0.86);
		--art-b: rgba(99, 102, 241, 0.52);
	}

	.project-card__media--3 {
		--art-a: rgba(196, 181, 253, 0.9);
		--art-b: rgba(76, 29, 149, 0.66);
	}

	.project-card__art {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(58% 54% at 70% 34%, var(--art-a), transparent 64%),
			radial-gradient(52% 58% at 28% 78%, var(--art-b), transparent 62%),
			linear-gradient(150deg, #181022 0%, #0a0611 72%);
		transition: transform 520ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.project-card__art::before {
		content: '';
		position: absolute;
		inset: 17% 23% 12% 25%;
		border: 1px solid rgba(255, 255, 255, 0.26);
		border-radius: 50%;
		transform: rotate(-18deg) scaleY(0.92);
		box-shadow: inset 0 0 60px rgba(255, 255, 255, 0.06);
	}

	.project-card__art::after {
		content: '';
		position: absolute;
		top: 18%;
		left: 20%;
		width: 26%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(255, 255, 255, 0.75), transparent 68%);
		filter: blur(8px);
	}

	.project-card:hover .project-card__art {
		transform: scale(1.04);
	}

	.project-card__index,
	.project-card__status {
		position: absolute;
		z-index: 1;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.68);
	}

	.project-card__index {
		top: 16px;
		left: 18px;
	}

	.project-card__status {
		bottom: 14px;
		left: 16px;
		padding: 5px 10px;
		border: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: var(--radius-sm);
		background: rgba(10, 6, 17, 0.45);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		color: rgba(255, 255, 255, 0.82);
	}

	.project-card__head {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-top: 20px;
	}

	.project-card__title {
		font-size: clamp(21px, 2.1vw, 27px);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.025em;
	}

	.project-card__title a {
		transition: color 160ms ease;
	}

	.project-card__title a:hover {
		color: var(--accent);
	}

	.project-card__dash {
		width: clamp(28px, 4vw, 46px);
		height: 1px;
		flex: none;
		background: var(--accent);
		opacity: 0.7;
	}

	.project-card__open {
		margin-left: auto;
		color: var(--muted);
		transition:
			color 160ms ease,
			transform 160ms ease;
	}

	.project-card__open .arrow {
		width: 18px;
		height: 18px;
	}

	.project-card__open:hover {
		color: var(--accent);
		transform: translate(2px, -2px);
	}

	.project-card__copy {
		margin-top: 12px;
		max-width: 46ch;
		font-size: 15px;
		line-height: 1.6;
		color: var(--muted);
	}

	.project-card__meta {
		display: grid;
		gap: 6px;
		margin-top: 18px;
	}

	.project-card__meta div {
		display: grid;
		grid-template-columns: 74px minmax(0, 1fr);
		gap: 14px;
		align-items: baseline;
	}

	.project-card__meta dt {
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.project-card__meta dd {
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--ink);
	}

	@media (max-width: 560px) {
		.project-card__meta div {
			grid-template-columns: 64px minmax(0, 1fr);
		}
	}
</style>
